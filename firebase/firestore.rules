rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // These flags are set server-side only; check the stored document value
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    // Fields that only the server (Admin SDK) may write
    function serverOnlyFields() {
      return ['isPremium', 'premiumExpiry', 'isBanned', 'reportCount',
              'isAdmin', 'isSuperAdmin', 'stripeCustomerId', 'stripeSubscriptionId'];
    }

    // ── App config (first-user super admin flag) ──────────────────────────────
    match /config/{doc} {
      // Readable by authenticated users so the client can check
      allow read: if isAuthenticated();
      // Only the Admin SDK can write config documents
      allow write: if false;
    }

    // ── Users collection ─────────────────────────────────────────────────────
    match /users/{uid} {
      // Own profile: always readable
      allow read: if isAuthenticated() && isOwner(uid);

      // Admins can read any profile
      allow read: if isAdmin();

      // Any authenticated user can create their own profile for the first time
      allow create: if isAuthenticated() && isOwner(uid);

      // Users may update their own profile but cannot touch server-only fields
      allow update: if isAuthenticated() && isOwner(uid) &&
        !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(serverOnlyFields());

      // Deletion is server-side only
      allow delete: if false;
    }

    // ── Reports ──────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Users can create reports where reporterUid matches their own UID
      allow create: if isAuthenticated() &&
        request.resource.data.reporterUid == request.auth.uid;

      // Only admins can read and manage reports
      allow read, update, delete: if isAdmin();
    }

    // ── Fallback: deny everything else ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
